LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选的本地工具路由，仅适用于单智能体，默认仍使用云端。
LOCAL_ROUTER_URL=http://127.0.0.1:8010
SEMANTIC_SCHOLAR_API_KEY=

# 可选：摘要输出额度；截断后不自动重试
LLM_SUMMARY_MAX_TOKENS=4096

# 可选的独立嵌入服务，三项全部留空时使用关键词检索。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选：仅 run.py --live --judge 使用，不影响日常问答；不自动复用 LLM 配置。
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
